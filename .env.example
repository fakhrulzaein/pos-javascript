# =========================================================
#  KONFIGURASI PER KLIEN — salin file ini menjadi ".env"
#  lalu sesuaikan nilainya. Jangan commit file .env ke git.
# =========================================================

# --- Server ---
PORT=3000
# 0.0.0.0 = bisa diakses dari komputer/tablet lain di jaringan toko (mode lokal).
# Di VPS (di belakang Nginx) isi 127.0.0.1 agar aplikasi tidak terbuka langsung ke internet.
HOST=0.0.0.0
# Isi "true" jika aplikasi berjalan di belakang HTTPS (cookie jadi Secure)
COOKIE_SECURE=false
# Isi "true" HANYA jika aplikasi berada di belakang Nginx / reverse proxy
TRUST_PROXY=false
# Durasi sesi login (jam)
SESSION_HOURS=12

# --- Database MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=native_pos
# Zona waktu yang dipakai MySQL untuk NOW() / laporan (WIB=+07:00, WITA=+08:00, WIT=+09:00)
DB_TIMEZONE=+07:00

# --- Website publik (SSG) ---
# URL publik website klien, dipakai untuk canonical URL & sitemap.xml
SITE_URL=http://localhost:3000

# --- Backup otomatis ---
# Jam backup harian (format 24 jam HH:MM, zona waktu server)
BACKUP_TIME=23:30
# Berapa hari file backup lokal disimpan
BACKUP_RETENTION_DAYS=14

# --- SMTP untuk kirim backup via email (opsional, kosongkan jika tidak dipakai) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Penerima email backup (boleh lebih dari satu, pisahkan dengan koma)
BACKUP_EMAIL_TO=

# --- Akun admin pertama (dipakai oleh "npm run setup") ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_FULLNAME=Administrator
